{
  "id": "soma-dos-pares-da-sequencia",
  "title": "Soma dos pares lidos",
  "topic": "Repetições",
  "summary": "Some apenas os valores pares de uma sequência.",
  "statement": "Leia N inteiros e some somente os valores pares.",
  "version": 1,
  "difficulty": "Básico",
  "inputFormat": "Primeira linha: N. Em seguida, N linhas com um inteiro cada.",
  "outputFormat": "Uma linha com a soma dos pares; se não houver pares, imprima 0.",
  "constraints": "1 ≤ N ≤ 100; cada valor está entre −1 000 e 1 000.",
  "starter": "# Escreva sua solução aqui.\n",
  "hints": [
    "Use % 2 para identificar pares.",
    "Acumule apenas os valores com resto zero."
  ],
  "tests": [
    {
      "input": "4\n2\n3\n4\n5\n",
      "expected": "6",
      "visible": true
    },
    {
      "input": "2\n1\n3\n",
      "expected": "0",
      "visible": true
    },
    {
      "input": "3\n-2\n0\n4\n",
      "expected": "2",
      "visible": true
    },
    {
      "input": "1\n0\n",
      "expected": "0",
      "visible": false
    },
    {
      "input": "1\n-8\n",
      "expected": "-8",
      "visible": false
    },
    {
      "input": "2\n1000\n1000\n",
      "expected": "2000",
      "visible": false
    }
  ],
  "prerequisites": [
    "leitura com input()",
    "conversão com int()",
    "saída com print()",
    "if/elif/else",
    "laços de repetição",
    "contadores e acumuladores"
  ]
}
